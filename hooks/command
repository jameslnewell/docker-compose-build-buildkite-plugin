#!/usr/bin/env bash
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${PLUGIN_DIR}/lib/shared.bash"

# Buildkite treats lines beginning with ---, +++ or ~~~ as log-group headers.
# The agent sources this hook, so `set -x` runs a few shell-nesting levels deep
# and bash replicates PS4's first character once per level — the default '+ '
# can become '+++ ', which Buildkite would parse as a group header (each traced
# command becomes its own section, leaving our intended groups empty). An empty
# PS4 emits no prefix at all (bash does not fall back to a default), so the
# traced command itself starts the line — and every command we trace begins
# with `docker`/`buildkite-agent`, never a marker.
PS4=''

SERVICE="${BUILDKITE_PLUGIN_DOCKER_COMPOSE_BUILD_SERVICE:-}"
if [[ -z "$SERVICE" ]]; then
  echo "Error: 'service' is required" >&2
  exit 1
fi

BUILDER_NAME="docker-compose-build-buildkite-plugin-${BUILDKITE_JOB_ID}"

if [[ -n "${BUILDKITE_COMMAND:-}" ]]; then
  echo "Warning: the step's command will not be run — this plugin only builds the image."
fi

echo "--- :docker: configuring"

set -x
docker buildx create --name "$BUILDER_NAME" --use
{ set +x; } 2>/dev/null

mapfile -t FILES < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_BUILD_FILE")

FILE_ARGS=()
ORIGINAL_DIR="$PWD"

if [[ ${#FILES[@]} -gt 0 ]]; then
  FIRST_FILE_DIR="$(cd "$(dirname "${FILES[0]}")" && pwd)"
  cd "$FIRST_FILE_DIR"

  FILE_ARGS=()
  for f in "${FILES[@]}"; do
    FILE_ARGS+=(--file "$(cd "$ORIGINAL_DIR" && realpath "$f")")
  done
else
  cd "$ORIGINAL_DIR"
fi

mapfile -t BUILD_ARGS < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_BUILD_ARGS")
mapfile -t LABELS < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_BUILD_LABELS")
mapfile -t CACHE_FROM < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_BUILD_CACHE_FROM")
mapfile -t CACHE_TO < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_BUILD_CACHE_TO")
mapfile -t PLATFORMS < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_BUILD_PLATFORMS")
mapfile -t TAGS < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_BUILD_TAGS")

# Generate a compose override file that carries args/labels/cache_from/cache_to/
# platforms/tags as full arrays. Older buildx versions (< 0.13) don't support
# the `--set name.field+=value` array-append syntax, so building the arrays in
# the compose layer is the portable way to pass them. The override is the
# last `--file` so it merges last; compose replaces arrays with the override's
# values, matching the intent of these options as "the final list to use".
#
# The file lives in its own per-job dir (BUILDKITE_JOB_ID is unique) so the
# upload below can address it by bare filename — keeping the artifact in the
# Buildkite UI named `docker-compose-build-buildkite-plugin.yml` (this
# plugin's name) rather than its per-job tmp path, and avoiding the special
# `docker-compose.override.yml` filename that compose auto-loads.
OVERRIDE_DIR="${TMPDIR:-/tmp}/docker-compose-build-buildkite-plugin-${BUILDKITE_JOB_ID}"
OVERRIDE_FILE="${OVERRIDE_DIR}/docker-compose-build-buildkite-plugin.yml"
mkdir -p "$OVERRIDE_DIR"
trap 'rm -rf "$OVERRIDE_DIR"' EXIT

# YAML-escape: wrap in single quotes, doubling any embedded `'` per YAML spec.
yaml_single_quote() {
  local v="${1//\'/\'\'}"
  printf "'%s'" "$v"
}

emit_string_list() {
  local key="$1"; shift
  (( $# > 0 )) || return 0
  printf '      %s:\n' "$key"
  for v in "$@"; do
    printf '        - %s\n' "$(yaml_single_quote "$v")"
  done
}

{
  printf 'services:\n'
  printf '  %s:\n' "$SERVICE"
  printf '    build:\n'

  # args is a list of KEY=VALUE entries — compose accepts both list and map
  # forms here; list keeps the KEY=VALUE shape the plugin already takes in.
  emit_string_list args "${BUILD_ARGS[@]}"
  emit_string_list labels "${LABELS[@]}"
  emit_string_list cache_from "${CACHE_FROM[@]}"
  emit_string_list cache_to "${CACHE_TO[@]}"
  emit_string_list platforms "${PLATFORMS[@]}"
  emit_string_list tags "${TAGS[@]}"
} > "$OVERRIDE_FILE"

FILE_ARGS+=(--file "$OVERRIDE_FILE")

# Surface the generated override as a Buildkite artifact so the resolved
# tags / labels / cache / platforms / args for this build are downloadable
# from the UI for debugging. Upload before bake runs so a failed bake
# doesn't take the artifact down with it.
( cd "$OVERRIDE_DIR" && buildkite-agent artifact upload docker-compose-build-buildkite-plugin.yml )

PUSH_LOAD_ARG=()
if [[ ${#TAGS[@]} -gt 0 ]]; then
  PUSH_LOAD_ARG=(--push)
else
  PUSH_LOAD_ARG=(--load)
fi

# Escape hatch for bake flags this plugin doesn't model as a first-class option
# (e.g. `--provenance false`, `--allow fs.read=<path>`).
mapfile -t CLI_ARGS < <(plugin_read_list "BUILDKITE_PLUGIN_DOCKER_COMPOSE_BUILD_CLI_ARGS")

echo "+++ :docker: building"
set -x
docker buildx bake \
  --progress=plain \
  --builder "$BUILDER_NAME" \
  "${FILE_ARGS[@]}" \
  "${PUSH_LOAD_ARG[@]}" \
  "${CLI_ARGS[@]}" \
  "${SERVICE}"
{ set +x; } 2>/dev/null
